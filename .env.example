# OANDA API Configuration
# Get your credentials from: https://developer.oanda.com/

# API Token
OANDA_API_TOKEN=your_api_token_here

# Account ID
OANDA_ACCOUNT_ID=your_account_id_here

# API Environment
# Set to 'practice' for demo/paper trading
# Set to 'live' for live trading (ONLY after extensive validation)
OANDA_ENVIRONMENT=practice

# Data cache directory
DATA_CACHE_DIR=./data/cache

# Log directory
LOG_DIR=./logs

# Trade state directory
STATE_DIR=./state
